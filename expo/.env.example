# URL del backend CreatorPrompt.
# In locale con Expo Go sul telefono usa l'IP del tuo PC sulla stessa rete Wi-Fi:
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.10:3000
# Con Cloudflare Tunnel invece:
# EXPO_PUBLIC_BACKEND_URL=https://tuo-tunnel.trycloudflare.com

# Account utenti (Supabase → Project Settings → API). Senza queste due l'app non chiede il login.
# La "anon public" key è fatta per stare nell'app; la service_role invece MAI qui.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

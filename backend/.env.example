# ── CreatorPrompt backend · copia in .env e riempi le chiavi ────────────────
PORT=3000
PUBLIC_URL=http://localhost:3000          # o l'URL di Cloudflare Tunnel
LLM_PROVIDER=gemini                       # gemini | ollama
GEMINI_API_KEY=                           # gratis: https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.0-flash             # modelli Flash/Flash-Lite: free tier
# Se il modello è sovraccarico (503) si passa a questi, in ordine:
# GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-flash-lite-latest,gemini-2.5-flash-lite
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Whisper: binario whisper.cpp compilato localmente (vedi README)
WHISPER_BIN=/usr/local/bin/whisper-cli
WHISPER_MODEL=/models/ggml-base.bin

# Montaggio
SILENCE_THRESHOLD_DB=-38                  # sotto questa soglia = silenzio
SILENCE_MIN_MS=700                        # pause più lunghe di così vengono tagliate

# Chiavi OAuth (tutte con piano gratuito)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# YouTube: privato finché il progetto Google non è verificato (public | unlisted | private)
# YOUTUBE_PRIVACY=private
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Chiave AES-256 per cifrare i token OAuth sul disco (genera: openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=

# Sottotitoli: allineamento parola per parola (DTW). Si ricava dal nome del modello
# (ggml-base.bin → base); metti "off" per disattivarlo.
# WHISPER_DTW=base
# Se i sottotitoli escono sempre in anticipo/ritardo: sposta tutto di N millisecondi (es. 150 o -150)
# SUB_OFFSET_MS=0

# Modmail & bug report: incolla qui un webhook Discord (Canale > Impostazioni > Integrazioni > Webhook)
# per ricevere i messaggi dell'app sul tuo server. Senza, finiscono solo in data/reports/.
# REPORT_WEBHOOK_URL=

# --- Account utenti (Supabase, gratis) ---
# Supabase → Project Settings → API. Senza SUPABASE_URL l'app funziona senza login (solo tu).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chiave "service_role": SEGRETA, solo qui nel backend (serve per "Elimina account").
SUPABASE_SERVICE_ROLE_KEY=
# Email degli amministratori (separate da virgola): nessun limite. Devono essere email confermate.
ADMIN_EMAILS=
